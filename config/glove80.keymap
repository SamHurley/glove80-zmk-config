#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include "custom_behaviors.dtsi"

#define HYPER LC(LS(LG(LALT)))

// layers
#define BASE 0
#define NUM 1
#define FN 2
#define MAGIC 3

/ {
    behaviors {
        magic: magic_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro_0 {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&rgb_ug RGB_STATUS>;
        };

        bt_0: bt_profile_macro_0 {
            label = "BT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 0>;
        };

        bt_1: bt_profile_macro_1 {
            label = "BT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 1>;
        };

        bt_2: bt_profile_macro_2 {
            label = "BT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 2>;
        };

        bt_3: bt_profile_macro_3 {
            label = "BT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 3>;
        };
    };

    combos {
      compatible = "zmk,combos";

      combo_home {
          timeout-ms = <50>;
          key-positions = <40 41>;
          bindings = <&kp HOME>;
      };

      combo_end {
          timeout-ms = <50>;
          key-positions = <41 42>;
          bindings = <&kp END>;
      };

      combo_pg_up {
          timeout-ms = <50>;
          key-positions = <29 30>;
          bindings = <&kp PG_UP>;
      };

      combo_pg_dn {
          timeout-ms = <50>;
          key-positions = <59 60>;
          bindings = <&kp PG_DN>;
      };

      combo_caps_word {
          timeout-ms = <50>;
          key-positions = <49 60>;
          bindings = <&caps_word>;
      };

    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
// |------------------|------------------|------------------|------------------|------------------|                                                                                                                                                       |------------------|------------------|------------------|------------------|------------------|
    &none              &none              &none              &kp DEL            &none                                                                                                                                                                      &none              &kp RET            &none              &none              &magic MAGIC 0
// |------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                 |------------------|------------------|------------------|------------------|------------------|------------------|
    &none              &kp N1             &kp N2             &kp N3             &kp N4             &kp N5                                                                                                                               &kp N6             &kp N7             &kp N8             &kp N9             &kp N0             &none
// |------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                 |------------------|------------------|------------------|------------------|------------------|------------------|
    &kp GRAVE          &kp Q              &kp W              &kp E              &kp R              &kp T                                                                                                                                &kp Y              &kp U              &kp I              &kp O              &kp P              &kp SQT 
// |------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                 |------------------|------------------|------------------|------------------|------------------|------------------|
    &hm_l LSHFT ESC    &kp A              &kp S              &hm_l LCTRL D      &hm_l LALT F       &kp G                                                                                                                                &kp H              &hm_r LALT J       &hm_r LCTRL K      &kp L              &kp SEMI           &hm_r RSHFT BSPC
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &kp BSLH           &kp Z              &kp X              &kp C              &kp V              &kp B              &none              &none              &none              &none              &none              &none              &kp N              &kp M              &kp COMMA          &kp DOT            &kp FSLH           &kp MINUS
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &kp LWIN           &none              &kp ESC            &kp F8             &kp F3                                &lt NUM BSPC       &skq LSHFT         &skq LCTRL         &skq RCTRL         &hm_r LSHFT TAB    &kp SPACE                             &kp LEFT           &kp DOWN           &kp UP             &kp RIGHT          &kp RWIN
// |------------------|------------------|------------------|------------------|------------------|                  |------------------|------------------|------------------|------------------|------------------|------------------|                  |------------------|------------------|------------------|------------------|------------------|
            >;
        };

        num_layer {
            bindings = <
// |------------------|------------------|------------------|------------------|------------------|                                                                                                                                                       |------------------|------------------|------------------|------------------|------------------|
    &trans             &trans             &trans             &trans             &trans                                                                                                                                                                     &trans             &trans             &trans             &trans             &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                 |------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &kp EXCL           &kp AT             &kp HASH           &kp DOLLAR         &kp PERCENT                                                                                                                          &kp CARET          &kp AMPERSAND      &kp ASTERISK       &none              &none              &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                 |------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &none              &none              &kp LEFT_BRACE     &kp RIGHT_BRACE    &none                                                                                                                                &none              &kp N7             &kp N8             &kp N9             &none              &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                 |------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &none              &none              &hm_l LCTRL LPAR   &hm_l LALT RPAR    &none                                                                                                                                &none              &kp N4             &kp N5             &kp N6             &kp SEMI           &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &none              &none              &kp LEFT_BRACKET   &kp RIGHT_BRACKET  &none              &trans             &trans             &trans             &trans             &trans             &trans             &none              &kp N1             &kp N2             &kp N3             &kp FSLH           &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &trans             &trans             &kp LESS_THAN      &kp GREATER_THAN                      &trans             &trans             &trans             &trans             &trans             &lt FN SPACE                          &kp N0             &kp COMMA          &kp DOT            &trans             &trans
// |------------------|------------------|------------------|------------------|------------------|                  |------------------|------------------|------------------|------------------|------------------|------------------|                  |------------------|------------------|------------------|------------------|------------------|
            >;
        };

        fn_layer {
            bindings = <
// |------------------|------------------|------------------|------------------|------------------|                                                                                                                                                       |------------------|------------------|------------------|------------------|------------------|
    &trans             &trans             &trans             &trans             &trans                                                                                                                                                                     &trans             &trans             &trans             &trans             &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                 |------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &none              &none              &none              &none              &none                                                                                                                                &none              &none              &none              &none              &none              &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                 |------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &none              &none              &none              &none              &none                                                                                                                                &kp F12            &kp F7             &kp F8             &kp F9             &none              &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                 |------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &none              &none              &kp LCTRL          &kp LALT           &none                                                                                                                                &kp F11            &kp F4             &kp F5             &kp F6             &none              &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &none              &none              &none              &none              &none              &trans             &trans             &trans             &trans             &trans             &trans             &kp F12            &kp F1             &kp F2             &kp F3             &none              &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &trans             &trans             &none              &none                                 &trans             &trans             &trans             &trans             &trans             &trans                                &none              &none              &none              &trans             &trans
// |------------------|------------------|------------------|------------------|------------------|                  |------------------|------------------|------------------|------------------|------------------|------------------|                  |------------------|------------------|------------------|------------------|------------------|
            >;
        };

        magic_layer {
            bindings = <
// |------------------|------------------|------------------|------------------|------------------|                                                                                                                                                       |------------------|------------------|------------------|------------------|------------------|
    &bt BT_CLR         &none              &none              &none              &none                                                                                                                                                                      &none              &none              &none              &none              &bt BT_CLR_ALL
// |------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                 |------------------|------------------|------------------|------------------|------------------|------------------|
    &none              &none              &none              &none              &none              &none                                                                                                                                &none              &none              &none              &none              &none              &none
// |------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                 |------------------|------------------|------------------|------------------|------------------|------------------|
    &none              &rgb_ug RGB_SPI    &rgb_ug RGB_SAI    &rgb_ug RGB_HUI    &rgb_ug RGB_BRI    &rgb_ug RGB_TOG                                                                                                                      &none              &none              &none              &none              &none              &none
// |------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                 |------------------|------------------|------------------|------------------|------------------|------------------|
    &bootloader        &rgb_ug RGB_SPD    &rgb_ug RGB_SAD    &rgb_ug RGB_HUD    &rgb_ug RGB_BRD    &rgb_ug RGB_EFF                                                                                                                      &none              &none              &none              &none              &none              &bootloader
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &sys_reset         &none              &none              &none              &none              &none              &bt_2              &bt_3              &none              &none              &none              &none              &none              &none              &none              &none              &none              &sys_reset
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &none              &none              &none              &none              &none                                 &bt_0              &bt_1              &out OUT_USB       &none              &none              &none                                 &none              &none              &none              &none              &none
// |------------------|------------------|------------------|------------------|------------------|                  |------------------|------------------|------------------|------------------|------------------|------------------|                  |------------------|------------------|------------------|------------------|------------------|
            >;
        };

    };
};
